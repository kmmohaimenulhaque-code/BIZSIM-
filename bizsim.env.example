# ─────────────────────────────────────────────────────────────
#  BIZSIM settings
#  Server / Docker:  copy to  .env  in the project folder
#  Desktop app:      copy to  bizsim.env  in the app data folder
#    Linux:   ~/.config/bizsim/bizsim.env
#    macOS:   ~/Library/Application Support/bizsim/bizsim.env
#    Windows: %APPDATA%\bizsim\bizsim.env
#  Rules: KEY=value, no spaces around "=", lines starting with # are ignored.
#  Every setting is optional. Restart BIZSIM after editing.
# ─────────────────────────────────────────────────────────────

# Port for the web server (ignored by the desktop app)
PORT=8787

# ── AI case synthesis ────────────────────────────────────────
# Add ONE key. If several are present: Anthropic → OpenAI → Gemini.
# Free option: Gemini key from https://aistudio.google.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Force a provider (optional): anthropic | openai | gemini | none
# LLM_PROVIDER=gemini

# Model names (optional).
# Gemini: leave GEMINI_MODEL empty and BIZSIM automatically picks the newest
# "flash" model your key can use — and switches if Google retires a model.
# Only set it to pin a specific model, e.g. gemini-3.8-flash
# GEMINI_MODEL=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible endpoints: OpenRouter, Groq, Together, or local Ollama
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama (no key needed)

# ── AI image generation ("Nano Banana") ──────────────────────
# Uses your Gemini (or OpenAI) key automatically. Free open-licence photos
# from Openverse are always used when this is off.
# IMAGE_PROVIDER=gemini        # gemini | openai | none
# GEMINI_IMAGE_MODEL=          # empty = auto-pick newest flash-image model
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── SEC EDGAR (US company financials) ────────────────────────
# No key needed — the SEC only requires your name and email:
SEC_USER_AGENT=Your Name your@email.com

# ── Hosting (web server only) ───────────────────────────────
# Allowed origins for mobile apps calling a hosted server (comma-separated)
# CORS_ORIGINS=*
# Where generated images are stored
# BIZSIM_DATA_DIR=./server/data
